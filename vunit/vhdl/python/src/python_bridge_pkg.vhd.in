--
-- PRIVATE foreign subprograms of the VUnit Python bridge (vunit/python_bridge/native).
--
-- This file is a template. VUnit substitutes every {foreign:<entry point>}
-- placeholder with the foreign attribute string of the selected simulator --
-- "VHPIDIRECT <library> <entry point>" for NVC and GHDL, "fli_<entry point>
-- <library>" for the FLI of Questa/ModelSim -- and compiles the result into
-- vunit_lib when Python support is enabled with add_python(). The public API
-- is python_pkg/python_ffi_pkg, which is implemented on top of this package.
--
-- Only scalars and constrained arrays cross the foreign interface since their
-- ABI is identical for NVC and GHDL on all platforms and is translated to the
-- FLI parameter passing conventions by native/fli.c.

package python_bridge_pkg is
  constant chunk_length : positive := 1024;
  subtype string_chunk_t is string(1 to chunk_length);
  subtype integer_chunk_t is integer_vector(0 to chunk_length - 1);
  subtype real_chunk_t is real_vector(0 to chunk_length - 1);

  -- Start the interpreter. Idempotent.
  impure function vpy_setup return integer;
  attribute foreign of vpy_setup : function is "{foreign:vpy_setup}";

  -- Flush Python's streams and drop the last result and the staged values.
  -- The interpreter is not finalized: later operations keep working.
  impure function vpy_cleanup return integer;
  attribute foreign of vpy_cleanup : function is "{foreign:vpy_cleanup}";

  impure function vpy_buffer_clear return integer;
  attribute foreign of vpy_buffer_clear : function is "{foreign:vpy_buffer_clear}";

  impure function vpy_buffer_append(chunk : string_chunk_t; length : integer) return integer;
  attribute foreign of vpy_buffer_append : function is "{foreign:vpy_buffer_append}";

  -- Start an operation in the session named by the buffer ("default" is __main__).
  impure function vpy_begin return integer;
  attribute foreign of vpy_begin : function is "{foreign:vpy_begin}";

  -- Execute the buffer as Python source (is_file = 0) or as a file name (is_file = 1).
  impure function vpy_execute(is_file : integer) return integer;
  attribute foreign of vpy_execute : function is "{foreign:vpy_execute}";

  -- Evaluate the buffer as a Python expression and convert the value to the
  -- VHDL type given by kind. width is the length of a std_ulogic_vector,
  -- signed or unsigned result, -1 when it is not known.
  impure function vpy_eval(kind, width : integer) return integer;
  attribute foreign of vpy_eval : function is "{foreign:vpy_eval}";

  impure function vpy_push_array(length, width, height, depth, bit_width, is_signed : integer) return integer;
  attribute foreign of vpy_push_array : function is "{foreign:vpy_push_array}";

  impure function vpy_array_write(chunk : integer_chunk_t; length : integer) return integer;
  attribute foreign of vpy_array_write : function is "{foreign:vpy_array_write}";

  -- Stage the pushed array and return its id (>= 1), -1 on error. Python
  -- source code refers to the value as __vunit__.staged(<id>).
  impure function vpy_stage return integer;
  attribute foreign of vpy_stage : function is "{foreign:vpy_stage}";

  impure function vpy_result_integer return integer;
  attribute foreign of vpy_result_integer : function is "{foreign:vpy_result_integer}";

  impure function vpy_result_real return real;
  attribute foreign of vpy_result_real : function is "{foreign:vpy_result_real}";

  impure function vpy_result_meta(idx : integer) return integer;
  attribute foreign of vpy_result_meta : function is "{foreign:vpy_result_meta}";

  impure function vpy_error_length return integer;
  attribute foreign of vpy_error_length : function is "{foreign:vpy_error_length}";

  procedure vpy_result_read_string(chunk : out string_chunk_t; offset, length : integer);
  attribute foreign of vpy_result_read_string : procedure is "{foreign:vpy_result_read_string}";

  procedure vpy_result_read_integers(chunk : out integer_chunk_t; offset, length : integer);
  attribute foreign of vpy_result_read_integers : procedure is "{foreign:vpy_result_read_integers}";

  procedure vpy_result_read_reals(chunk : out real_chunk_t; offset, length : integer);
  attribute foreign of vpy_result_read_reals : procedure is "{foreign:vpy_result_read_reals}";

  procedure vpy_error_read(chunk : out string_chunk_t; offset, length : integer);
  attribute foreign of vpy_error_read : procedure is "{foreign:vpy_error_read}";
end package;

package body python_bridge_pkg is
  -- The bodies are replaced by the foreign implementations and never executed.
  impure function vpy_setup return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_setup is not bound" severity failure;
    return 1;
  end;

  impure function vpy_cleanup return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_cleanup is not bound" severity failure;
    return 1;
  end;

  impure function vpy_buffer_clear return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_buffer_clear is not bound" severity failure;
    return 1;
  end;

  impure function vpy_buffer_append(chunk : string_chunk_t; length : integer) return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_buffer_append is not bound" severity failure;
    return 1;
  end;

  impure function vpy_begin return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_begin is not bound" severity failure;
    return 1;
  end;

  impure function vpy_execute(is_file : integer) return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_execute is not bound" severity failure;
    return 1;
  end;

  impure function vpy_eval(kind, width : integer) return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_eval is not bound" severity failure;
    return 1;
  end;

  impure function vpy_push_array(length, width, height, depth, bit_width, is_signed : integer) return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_push_array is not bound" severity failure;
    return 1;
  end;

  impure function vpy_array_write(chunk : integer_chunk_t; length : integer) return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_array_write is not bound" severity failure;
    return 1;
  end;

  impure function vpy_stage return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_stage is not bound" severity failure;
    return -1;
  end;

  impure function vpy_result_integer return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_result_integer is not bound" severity failure;
    return 1;
  end;

  impure function vpy_result_real return real is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_result_real is not bound" severity failure;
    return 0.0;
  end;

  impure function vpy_result_meta(idx : integer) return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_result_meta is not bound" severity failure;
    return 1;
  end;

  impure function vpy_error_length return integer is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_error_length is not bound" severity failure;
    return 1;
  end;

  procedure vpy_result_read_string(chunk : out string_chunk_t; offset, length : integer) is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_result_read_string is not bound" severity failure;
  end;

  procedure vpy_result_read_integers(chunk : out integer_chunk_t; offset, length : integer) is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_result_read_integers is not bound" severity failure;
  end;

  procedure vpy_result_read_reals(chunk : out real_chunk_t; offset, length : integer) is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_result_read_reals is not bound" severity failure;
  end;

  procedure vpy_error_read(chunk : out string_chunk_t; offset, length : integer) is
  begin
    report "VUnit Python bridge: foreign subprogram vpy_error_read is not bound" severity failure;
  end;
end package body;
